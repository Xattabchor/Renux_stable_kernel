!!IMGvp1.0
# Quaternion skinning: two vec4 parameter rows per rigid bone.
# Row 2*b is unit quaternion (x,y,z,w); row 2*b+1 is translation (x,y,z,unused).
# vertex.attrib[1] = four integer-valued bone indices; attrib[2] = four weights.
# Bone indices are in [0,15]; input quaternions must be normalized.
ATTRIB iPos = vertex.position;
ATTRIB iNormal = vertex.normal;
ATTRIB iBones = vertex.attrib[1];
ATTRIB iWeights = vertex.attrib[2];
ATTRIB iUV = vertex.texcoord[0];
PARAM mvp[4] = { state.matrix.mvp };
PARAM boneRows[32] = { program.local[0..15], program.env[0..15] };
TEMP pAcc, nAcc, outTmp, crossTmp, scalarTmp;
ADDRESS A0;
MOV pAcc, 0.0;
MOV nAcc, 0.0;
# influence 0: quaternion rotation using reusable temporaries
MUL scalarTmp.x, iBones.x, 2.0;
ARL A0.x, scalarTmp.x;
MUL crossTmp.x, boneRows[A0.x + 0].y, iPos.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iPos.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iPos.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iPos.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iPos.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iPos.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iPos.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iPos.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iPos.z;
ADD outTmp.xyz, outTmp, boneRows[A0.x + 1];
MOV outTmp.w, 1.0;
MAD pAcc.xyz, outTmp, iWeights.x, pAcc;
MAD pAcc.w, iWeights.x, 1.0, pAcc.w;
MUL crossTmp.x, boneRows[A0.x + 0].y, iNormal.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iNormal.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iNormal.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iNormal.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iNormal.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iNormal.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iNormal.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iNormal.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iNormal.z;
MAD nAcc.xyz, outTmp, iWeights.x, nAcc;
# influence 1: quaternion rotation using reusable temporaries
MUL scalarTmp.x, iBones.y, 2.0;
ARL A0.x, scalarTmp.x;
MUL crossTmp.x, boneRows[A0.x + 0].y, iPos.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iPos.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iPos.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iPos.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iPos.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iPos.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iPos.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iPos.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iPos.z;
ADD outTmp.xyz, outTmp, boneRows[A0.x + 1];
MOV outTmp.w, 1.0;
MAD pAcc.xyz, outTmp, iWeights.y, pAcc;
MAD pAcc.w, iWeights.y, 1.0, pAcc.w;
MUL crossTmp.x, boneRows[A0.x + 0].y, iNormal.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iNormal.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iNormal.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iNormal.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iNormal.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iNormal.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iNormal.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iNormal.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iNormal.z;
MAD nAcc.xyz, outTmp, iWeights.y, nAcc;
# influence 2: quaternion rotation using reusable temporaries
MUL scalarTmp.x, iBones.z, 2.0;
ARL A0.x, scalarTmp.x;
MUL crossTmp.x, boneRows[A0.x + 0].y, iPos.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iPos.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iPos.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iPos.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iPos.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iPos.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iPos.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iPos.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iPos.z;
ADD outTmp.xyz, outTmp, boneRows[A0.x + 1];
MOV outTmp.w, 1.0;
MAD pAcc.xyz, outTmp, iWeights.z, pAcc;
MAD pAcc.w, iWeights.z, 1.0, pAcc.w;
MUL crossTmp.x, boneRows[A0.x + 0].y, iNormal.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iNormal.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iNormal.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iNormal.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iNormal.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iNormal.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iNormal.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iNormal.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iNormal.z;
MAD nAcc.xyz, outTmp, iWeights.z, nAcc;
# influence 3: quaternion rotation using reusable temporaries
MUL scalarTmp.x, iBones.w, 2.0;
ARL A0.x, scalarTmp.x;
MUL crossTmp.x, boneRows[A0.x + 0].y, iPos.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iPos.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iPos.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iPos.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iPos.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iPos.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iPos.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iPos.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iPos.z;
ADD outTmp.xyz, outTmp, boneRows[A0.x + 1];
MOV outTmp.w, 1.0;
MAD pAcc.xyz, outTmp, iWeights.w, pAcc;
MAD pAcc.w, iWeights.w, 1.0, pAcc.w;
MUL crossTmp.x, boneRows[A0.x + 0].y, iNormal.z;
MAD crossTmp.x, -boneRows[A0.x + 0].z, iNormal.y, crossTmp.x;
MUL crossTmp.y, boneRows[A0.x + 0].z, iNormal.x;
MAD crossTmp.y, -boneRows[A0.x + 0].x, iNormal.z, crossTmp.y;
MUL crossTmp.z, boneRows[A0.x + 0].x, iNormal.y;
MAD crossTmp.z, -boneRows[A0.x + 0].y, iNormal.x, crossTmp.z;
MUL outTmp.x, boneRows[A0.x + 0].y, crossTmp.z;
MAD outTmp.x, -boneRows[A0.x + 0].z, crossTmp.y, outTmp.x;
MAD outTmp.x, boneRows[A0.x + 0].w, crossTmp.x, outTmp.x;
MUL outTmp.x, outTmp.x, 2.0;
ADD outTmp.x, outTmp.x, iNormal.x;
MUL outTmp.y, boneRows[A0.x + 0].z, crossTmp.x;
MAD outTmp.y, -boneRows[A0.x + 0].x, crossTmp.z, outTmp.y;
MAD outTmp.y, boneRows[A0.x + 0].w, crossTmp.y, outTmp.y;
MUL outTmp.y, outTmp.y, 2.0;
ADD outTmp.y, outTmp.y, iNormal.y;
MUL outTmp.z, boneRows[A0.x + 0].x, crossTmp.y;
MAD outTmp.z, -boneRows[A0.x + 0].y, crossTmp.x, outTmp.z;
MAD outTmp.z, boneRows[A0.x + 0].w, crossTmp.z, outTmp.z;
MUL outTmp.z, outTmp.z, 2.0;
ADD outTmp.z, outTmp.z, iNormal.z;
MAD nAcc.xyz, outTmp, iWeights.w, nAcc;
DP4 result.position.x, mvp[0], pAcc;
DP4 result.position.y, mvp[1], pAcc;
DP4 result.position.z, mvp[2], pAcc;
DP4 result.position.w, mvp[3], pAcc;
DP3 scalarTmp.x, nAcc, nAcc;
MAX scalarTmp.x, scalarTmp.x, 0.0001;
RSQ scalarTmp.x, scalarTmp.x;
MUL nAcc.xyz, nAcc, scalarTmp.x;
MAD result.color.xyz, nAcc, 0.5, 0.5;
MOV result.color.w, 1.0;
MOV result.texcoord[0], iUV;
END
